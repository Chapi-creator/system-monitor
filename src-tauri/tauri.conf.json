{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "System Monitor Widget",
  "version": "1.1.0",
  "identifier": "com.breiner.sysmonwidget",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "System Monitor Widget",
        "width": 340,
        "height": 500,
        "minWidth": 340,
        "minHeight": 245,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "shadow": false,
        "visible": true,
        "backgroundColor": "#0a0c14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}